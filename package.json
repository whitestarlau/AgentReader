{
	"name": "agent-reader-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"check": "biome check --write --error-on-warnings . && npm run typecheck --workspaces --if-present",
		"dev": "npm run dev --workspace=@agentreader/app",
		"test": "npm run test --workspaces --if-present"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"electron": "^38.2.1",
		"epubjs": "^0.3.93",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1"
	}
}
