{
	"name": "@agentreader/app",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Desktop AI document reader for PDF / EPUB with highlighting and AI chat",
	"author": "whitestar.lau",
	"main": "dist-electron/main.js",
	"scripts": {
		"postinstall": "node scripts/patch-dev-app-name.mjs",
		"predev": "node scripts/patch-dev-app-name.mjs",
		"dev": "vite",
		"dev:web": "vite --config vite.web.config.ts",
		"build": "tsc --project tsconfig.json && vite build",
		"package": "npm run build && electron-builder --config electron-builder.json",
		"package:dir": "npm run build && electron-builder --config electron-builder.json --dir",
		"typecheck": "tsc --noEmit",
		"test": "node --experimental-strip-types --test src/shared/chat-export.test.ts src/main/export/render.test.ts src/main/tts/segment.test.ts src/main/tts/pipeline.test.ts src/main/tts/registry.test.ts src/main/tts/cache.test.ts src/main/tts/providers/mock.test.ts src/main/tts/providers/openai-compatible.test.ts src/main/tts/wav.test.ts src/main/tts/providers/sherpa.test.ts src/main/tts/models.test.ts src/renderer/read-aloud.test.ts",
		"check": "biome check --write --error-on-warnings .",
		"test:electron": "electron scripts/electron-tts-smoke.cjs --no-sandbox --disable-gpu"
	},
	"dependencies": {
		"@agentreader/agent": "0.1.0",
		"@agentreader/ai": "0.1.0",
		"pdfjs-dist": "5.4.394",
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sherpa-onnx-node": "^2.0.1",
		"tesseract.js": "^7.0.0",
		"unified": "^11.0.5",
		"zustand": "5.0.7"
	},
	"devDependencies": {
		"@types/react": "19.1.11",
		"@types/react-dom": "19.1.4",
		"@vitejs/plugin-react": "5.0.4",
		"electron": "38.2.1",
		"electron-builder": "^26.15.3",
		"vite": "7.1.7",
		"vite-plugin-electron": "0.29.0"
	}
}
