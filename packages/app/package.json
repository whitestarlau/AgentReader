{
	"name": "@agentreader/app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "vite",
		"dev:web": "vite --config vite.web.config.ts",
		"build": "tsc --project tsconfig.json && vite build",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write --error-on-warnings ."
