	"dependencies": {
		"@agentreader/agent": "0.1.0",
		"@agentreader/ai": "0.1.0",
		"pdfjs-dist": "5.4.394",
		"react": "19.1.1",
		"react-dom": "19.1.1",
		"tesseract.js": "^7.0.0",
		"zustand": "5.0.7"
	},
	"devDependencies": {
		"@types/react": "19.1.11",
		"@types/react-dom": "19.1.4",
		"@vitejs/plugin-react": "5.0.4",
		"electron": "38.2.1",
		"vite": "7.1.7",
		"vite-plugin-electron": "0.29.0"
	}
}
