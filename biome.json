{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"!**/node_modules/**/*",
			"!!**/node_modules",
			"!!Reference"
		]
	}
}
